<p>Hi <%= @appointment.name %>,</p>

<p>
  Please use the link below to pick a new time for your appointment
  (currently scheduled for <%= format_in_business_zone(@appointment.starts_at) %>).
</p>

<p>
  <a href="<%= @reschedule_url %>"><%= @reschedule_url %></a>
</p>

<% if @expires_at.present? %>
  <p>This link expires on <%= format_in_business_zone(@expires_at) %>.</p>
<% end %>

<p>— Throne Technology</p>
